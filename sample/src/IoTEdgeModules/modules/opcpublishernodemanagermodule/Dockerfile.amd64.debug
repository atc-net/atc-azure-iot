# Build from the repository root: docker build -f sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/Dockerfile.amd64.debug .
FROM mcr.microsoft.com/dotnet/runtime:10.0 AS base

RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip procps curl && \
    rm -rf /var/lib/apt/lists/*

USER app
RUN curl -sSL https://aka.ms/getvsdbgsh | bash /dev/stdin -v latest -l ~/vsdbg

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /repo

COPY global.json Directory.Build.props .editorconfig ./
COPY src/Directory.Build.props ./src/
COPY src/Atc.Azure.IoTEdge/ ./src/Atc.Azure.IoTEdge/
COPY sample/src/Atc.Azure.Iot.Sample.Modules.Contracts/ ./sample/src/Atc.Azure.Iot.Sample.Modules.Contracts/
COPY sample/src/IoTEdgeModules/.editorconfig ./sample/src/IoTEdgeModules/
COPY sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/ ./sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/

RUN dotnet publish "sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/OpcPublisherNodeManagerModule.csproj" -c Debug -o /app/out

FROM base
WORKDIR /app
COPY --from=build-env /app/out ./

ENTRYPOINT ["dotnet", "OpcPublisherNodeManagerModule.dll"]
