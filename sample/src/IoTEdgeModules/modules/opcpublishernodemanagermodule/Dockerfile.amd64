# Build from the repository root: docker build -f sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/Dockerfile.amd64 .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /repo

COPY global.json Directory.Build.props .editorconfig ./
COPY src/Directory.Build.props ./src/
COPY src/Atc.Azure.IoTEdge/ ./src/Atc.Azure.IoTEdge/
COPY sample/src/Atc.Azure.Iot.Sample.Modules.Contracts/ ./sample/src/Atc.Azure.Iot.Sample.Modules.Contracts/
COPY sample/src/IoTEdgeModules/.editorconfig ./sample/src/IoTEdgeModules/
COPY sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/ ./sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/

RUN dotnet publish "sample/src/IoTEdgeModules/modules/opcpublishernodemanagermodule/OpcPublisherNodeManagerModule.csproj" -c Release -o /app/out

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build-env /app/out ./

USER app

ENTRYPOINT ["dotnet", "OpcPublisherNodeManagerModule.dll"]
