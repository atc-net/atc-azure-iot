<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Atc.Azure.IoTEdge.DeviceEmulator</PackageId>
    <PackageTags>azure;iot;iotedge;edgehub;emulation;emulator</PackageTags>
    <Description>Atc.Azure.IoTEdge.DeviceEmulator contains the building blocks for emulating an IoT Edge device locally: device and module identity provisioning in Azure IoT Hub, edgeHub test certificates and deployment manifest parsing.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Link="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Atc" Version="3.0.186" />
    <PackageReference Include="Microsoft.Azure.Devices" Version="1.41.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.Azure.IoT\Atc.Azure.IoT.csproj" />
  </ItemGroup>

</Project>
